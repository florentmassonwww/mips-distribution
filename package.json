{
  "name": "mips-business-suite",
  "version": "0.1.0",
  "private": true,
  "description": "MIPS Business Suite: business modules for MIPS merchants (Distribution, Club). Demo only, no real payment.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:i18n && npm run test:reference && npm run test:api && npm run test:api-unit",
    "typecheck": "tsc -p apps/api && tsc -p apps/web && tsc -p packages",
    "test:reference": "node --no-warnings tests/characterization/run.mjs",
    "test:i18n": "node --no-warnings tests/i18n/check.mjs",
    "test:api": "node --no-warnings tests/characterization/run.mjs --target=api",
    "test:api-unit": "node --no-warnings --test \"tests/api/*.test.mjs\"",
    "golden:update": "node --no-warnings tests/characterization/run.mjs --update",
    "build": "npm run build -w @mips/web",
    "test:visual": "npm run build && node --no-warnings tests/visual/run.mjs"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.5.0",
    "@types/node": "22.20.5",
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
