{
  "scenario": "club-charges",
  "description": "Consumption and fee charges per outlet; finance cancels a charge with a reason; balances follow.",
  "transcript": [
    {
      "step": "login u_cs_secretariat",
      "as": "u_cs_secretariat",
      "request": {
        "method": "POST",
        "path": "/api/demo/login",
        "body": {
          "userId": "u_cs_secretariat"
        }
      },
      "status": 200,
      "response": {
        "ok": true
      }
    },
    {
      "step": "members",
      "as": "u_cs_secretariat",
      "request": {
        "method": "GET",
        "path": "/api/club/members"
      },
      "status": 200,
      "response": "<not recorded>"
    },
    {
      "step": "bar consumption",
      "as": "u_cs_secretariat",
      "request": {
        "method": "POST",
        "path": "/api/club/members/<mbr#1>/charges",
        "body": {
          "kind": "consumption",
          "outlet": "bar",
          "label": "Consommations bar (démo)",
          "amountMinor": 45000
        }
      },
      "status": 200,
      "response": {
        "id": "<chg#1>"
      }
    },
    {
      "step": "court fee",
      "as": "u_cs_secretariat",
      "request": {
        "method": "POST",
        "path": "/api/club/members/<mbr#1>/charges",
        "body": {
          "kind": "fee",
          "outlet": "tennis",
          "label": "Location court (démo)",
          "amountMinor": 30000
        }
      },
      "status": 200,
      "response": {
        "id": "<chg#2>"
      }
    },
    {
      "step": "dues cannot be charged by hand",
      "as": "u_cs_secretariat",
      "request": {
        "method": "POST",
        "path": "/api/club/members/<mbr#1>/charges",
        "body": {
          "kind": "dues",
          "outlet": "bar",
          "label": "Interdit",
          "amountMinor": 100
        }
      },
      "status": 400,
      "response": {
        "error": {
          "code": "invalid_input",
          "message": "Données invalides : kind Invalid option: expected one of \"consumption\"|\"fee\""
        }
      }
    },
    {
      "step": "unknown outlet",
      "as": "u_cs_secretariat",
      "request": {
        "method": "POST",
        "path": "/api/club/members/<mbr#1>/charges",
        "body": {
          "kind": "consumption",
          "outlet": "piscine",
          "label": "Inconnu",
          "amountMinor": 100
        }
      },
      "status": 400,
      "response": {
        "error": {
          "code": "invalid_input",
          "message": "Données invalides : outlet Invalid option: expected one of \"restaurant\"|\"bar\"|\"tennis\"|\"squash\"|\"golf\"|\"shop\"|\"events\"|\"other\""
        }
      }
    },
    {
      "step": "secretariat cannot cancel",
      "as": "u_cs_secretariat",
      "request": {
        "method": "POST",
        "path": "/api/club/charges/<chg#1>/cancel",
        "body": {
          "reason": "Erreur"
        }
      },
      "status": 403,
      "response": {
        "error": {
          "code": "forbidden",
          "message": "Accès non autorisé."
        }
      }
    },
    {
      "step": "login u_cs_compta",
      "as": "u_cs_compta",
      "request": {
        "method": "POST",
        "path": "/api/demo/login",
        "body": {
          "userId": "u_cs_compta"
        }
      },
      "status": 200,
      "response": {
        "ok": true
      }
    },
    {
      "step": "finance cancels",
      "as": "u_cs_compta",
      "request": {
        "method": "POST",
        "path": "/api/club/charges/<chg#1>/cancel",
        "body": {
          "reason": "Erreur de saisie (démo)"
        }
      },
      "status": 200,
      "response": {
        "ok": true
      }
    },
    {
      "step": "cancel twice",
      "as": "u_cs_compta",
